# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# API key of the OpenAI-compatible vision endpoint (PROXY_BASE_URL)
PROXY_API_KEY=
# Chats the bot works in, comma-separated. Send /chatid in the group to learn its id.
# Empty: the bot analyses nothing.
ALLOWED_CHAT_IDS=

# Optional (defaults shown)
# PROXY_BASE_URL=http://127.0.0.1:8317
# VISION_MODEL=gemini-3.5-flash-lite
# TIMEZONE=Europe/Istanbul
# REPORT_TIME=23:55
# TRIGGER_MODE=mention      # all: every photo in an allowed chat is analysed
# DB_PATH=data/kalori.db
